# Copy to .env (git-ignored) and fill in. Only service URLs and demo accounts go here - NEVER a Gemini key.
VITE_USE_MOCKS=false
VITE_API_URL=
VITE_AI_API_URL=
# true = fixed fake AI answers, no AI service needed (UI work / offline demo). Leave unset in production.
VITE_AI_USE_MOCKS=

VITE_DEPOT_USERNAME=
VITE_DEPOT_PASSWORD=
VITE_DRIVER_USERNAME=
VITE_DRIVER_PASSWORD=
VITE_COORDINATOR_USERNAME=
VITE_COORDINATOR_PASSWORD=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# true = every feature uses the bundled sample data (needs VITE_USE_MOCKS=true). For offline demos and screenshots.
VITE_MOCK_ALL=
