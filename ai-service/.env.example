# Copy this file to .env and fill in the values. NEVER commit .env.
GEMINI_KEY_A=
GEMINI_KEY_B=
# gemini-flash-lite-latest always points at the current Flash model (older names get retired for new users).
GEMINI_MODEL=gemini-flash-lite-latest
# auto/studio = AI Studio keys (default). Use vertex only for Google Cloud Vertex AI keys.
GEMINI_BACKEND=auto
KARWAN_API_URL=http://localhost:4000
FRONTEND_ORIGIN=http://localhost:5173
AI_REQUEST_TIMEOUT_SECONDS=20
# LOW = fast, steady replies on current models. Set empty if your model rejects it (older 2.x models).
GEMINI_THINKING_LEVEL=LOW
